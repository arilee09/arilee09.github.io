---
import { withBase } from '../lib/url.js';
import FrameMarks from './FrameMarks.astro';

interface ImgSpec { src: string; alt: string; }
interface Props {
  id: string;
  images: ImgSpec[];
  ratio?: 'default' | 'wide' | 'contain';
}
const { id, images, ratio = 'default' } = Astro.props;
const ratioClass = ratio === 'wide' ? 'feature-frame--wide' : ratio === 'contain' ? 'feature-frame--contain' : '';
---
<div class="slideshow" id={`slideshow-${id}`} data-slideshow>
  <div class={`feature-frame ${ratioClass}`}>
    <FrameMarks />
    <div class="slideshow__track" data-track>
      {images.map((img, i) => (
        <div class="slideshow__slide" data-slide>
          <img src={withBase(img.src)} alt={img.alt} loading={i < 3 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    {images.length > 1 && (
      <>
        <button class="slideshow__btn slideshow__btn--prev" data-prev aria-label="Previous image" type="button">‹</button>
        <button class="slideshow__btn slideshow__btn--next" data-next aria-label="Next image" type="button">›</button>
        <span class="slideshow__counter"><span data-current>1</span> / {images.length}</span>
      </>
    )}
  </div>
  {images.length > 1 && (
    <div class="slideshow__caption caption" data-caption>{images[0].alt}</div>
  )}
</div>

<script>
  function initSlideshows(root: ParentNode) {
    root.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((el) => {
      if (el.dataset.ready) return;
      el.dataset.ready = '1';

      const track = el.querySelector<HTMLElement>('[data-track]');
      const slides = Array.from(el.querySelectorAll<HTMLElement>('[data-slide]'));
      const prevBtn = el.querySelector<HTMLButtonElement>('[data-prev]');
      const nextBtn = el.querySelector<HTMLButtonElement>('[data-next]');
      const counter = el.querySelector<HTMLElement>('[data-current]');
      const caption = el.querySelector<HTMLElement>('[data-caption]');
      if (!track || slides.length < 2) return;

      const alts = slides.map((s) => s.querySelector('img')?.alt || '');
      let index = 0;

      const goTo = (i: number) => {
        index = (i + slides.length) % slides.length;
        track.scrollTo({ left: slides[index].offsetLeft, behavior: 'smooth' });
      };

      prevBtn?.addEventListener('click', () => goTo(index - 1));
      nextBtn?.addEventListener('click', () => goTo(index + 1));

      el.tabIndex = 0;
      el.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') goTo(index - 1);
        if (e.key === 'ArrowRight') goTo(index + 1);
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const i = slides.indexOf(entry.target as HTMLElement);
              if (i !== -1) {
                index = i;
                if (counter) counter.textContent = String(i + 1);
                if (caption) caption.textContent = alts[i];
              }
            }
          });
        },
        { root: track, threshold: 0.6 }
      );
      slides.forEach((s) => observer.observe(s));
    });
  }

  initSlideshows(document);
</script>
