---
import Layout from '../layouts/Layout.astro';
import ArcMotif from '../components/ArcMotif.astro';
import Moment from '../components/Moment.astro';
import { withBase } from '../lib/url.js';
---
<Layout title="Service" description="Hair donation and the mentoring, tutoring, and peer support that fill the rest of the week." slug="service">
  <section class="section section--tight">
    <span class="eyebrow">Service</span>
    <h1 style="font-size:clamp(2rem,4vw,2.8rem); margin-top:0.5rem;">Grown, Then Given Away</h1>
    <p class="lede">
      Ten years of the same quiet commitment, plus the mentoring and tutoring that fill the rest
      of my week at Exeter.
    </p>
  </section>

  <section class="section">
    <Moment
      num="Community Service — Ten Years Running"
      title="Hair Donation, Wigs for Kids"
      images={[
        { src: 'images/hair-donation/hair-donation-01.jpg', alt: 'Ari Lee holding freshly cut hair, moments after donating it' },
        { src: 'images/hair-donation/hair-donation-02.jpg', alt: 'Several braided hair donations bundled and ready to send to Wigs for Kids' },
      ]}
    >
      <p>
        I've donated my hair to Wigs for Kids three times over the last ten years — one of the
        few organizations that accepts hair for children who can't use chemically treated wigs,
        for medical reasons. In between donations, I keep my hair free of perms, bleach, and dye,
        on purpose, so it's still usable when it's cut.
      </p>
    </Moment>
  </section>

  <div class="arc-divider"><ArcMotif size={48} /></div>

  <section class="section section--tight">
    <span class="eyebrow">Also at Exeter</span>
    <ul class="awards-list" style="margin-top:0.8rem;">
      <li>
        <div><span class="award-title">Student Listener</span><span class="award-detail">Peer mental-health support in my dorm — an open door, weekly, plus ongoing leadership training</span></div>
        <span class="award-year">2025–Present</span>
      </li>
      <li>
        <div><span class="award-title">ISO Mentor</span><span class="award-detail">Mentored 70 incoming international students adjusting to Exeter and to living in a new country</span></div>
        <span class="award-year">2025</span>
      </li>
      <li>
        <div><span class="award-title">ESSO Flute</span><span class="award-detail">Tutor young students in flute through Exeter's student service organization</span></div>
        <span class="award-year">2023–Present</span>
      </li>
      <li>
        <div><span class="award-title">ESSO Math</span><span class="award-detail">Tutor young students in math</span></div>
        <span class="award-year">2025–Present</span>
      </li>
      <li>
        <div><span class="award-title">Back to Bach</span></div>
        <span class="award-year">2025–Present</span>
      </li>
    </ul>
    <p class="caption" style="margin-top:1.2rem;">
      I also perform for the Riverwoods nursing-home community — see <a href={withBase('music')}>Music</a>.
    </p>
  </section>
</Layout>
