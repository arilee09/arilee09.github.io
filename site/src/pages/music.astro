---
import Layout from '../layouts/Layout.astro';
import ArcMotif from '../components/ArcMotif.astro';
import Moment from '../components/Moment.astro';
---
<Layout title="Music" description="Ten years of flute — Phillips Exeter Symphony Orchestra, solo recitals, and songs aired on TV and in a national ad." slug="music">
  <section class="section section--tight">
    <span class="eyebrow">Music</span>
    <h1 style="font-size:clamp(2rem,4vw,2.8rem); margin-top:0.5rem;">Second Flute</h1>
    <p class="lede">
      I picked up the flute in 2016 and haven't put it down since — ten years now, including two
      seasons as second flute in the Phillips Exeter Symphony Orchestra, two solo recitals at
      Kukje Recital Hall, and, more recently, writing and producing songs of my own.
    </p>
  </section>

  <section class="section">
    <div class="moment">
      <div class="moment__media">
        <div class="youtube-embed">
          <iframe
            src="https://www.youtube-nocookie.com/embed/WZRZ5d_fftM"
            title="Ari Lee — flute solo performance"
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <div class="moment__body">
        <span class="moment__num">01 — Ten Years Running</span>
        <h3 class="moment__title">Solo Recitals &amp; Symphony Orchestra</h3>
        <p>
          I performed <em>Hypnosis</em> by Ian Clark as a solo recital at Kukje Recital Hall in
          September 2024, then returned in August 2025 for <em>Syrinx</em> and the Hamburger
          Sonata. At Exeter I'm second flute in a 50-plus member Symphony Orchestra, with
          full-scale concerts every semester.
        </p>
        <p class="caption">Photos from Kukje Recital Hall and the Symphony Orchestra — coming soon.</p>
      </div>
    </div>

    <Moment
      num="02"
      meta="When I Was Young"
      title="Song Production — On TV, In an Ad"
      images={[
        { src: 'images/film/film-01.jpg', alt: 'Ari Lee on set in a school uniform behind camera monitors, filming 소년시대' },
      ]}
    >
      <p>
        I've been writing and producing original songs about the emotional landscape of
        adolescence since 2023, with music videos that have surpassed 500,000 views on YouTube.
        <strong>"When I Was Young," </strong> a song I co-wrote styled as a 1970s pop ballad,
        became the main theme track for the Korean web series <em>Boyhood</em> (소년시대) — the
        same production I appear in as an actor — and was later featured in an official
        McDonald's advertising campaign.
      </p>
      <p>
        I also host <em>More Than K-Pop</em>, a radio show introducing American audiences to
        Korean music beyond the mainstream.
      </p>
    </Moment>

    <Moment
      num="03 — Chamber Music Concert, Fall 2023"
      title="Flute, Oboe &amp; Harpsichord Trio"
      images={[
        { src: 'images/flute-2023-chamber-music/flute-2023-chamber-music-02.jpg', alt: 'Flute, oboe, and harpsichord trio performing on stage' },
        { src: 'images/flute-2023-chamber-music/flute-2023-chamber-music-01.jpg', alt: 'Two flutists performing during an ensemble concert' },
        { src: 'images/flute-2023-chamber-music/flute-2023-chamber-music-03.jpg', alt: 'Overhead view of the full trio performing in the glass-walled recital hall' },
      ]}
    >
      <p>
        My first musical performance at Phillips Exeter Academy — flute, with Sophia on
        harpsichord and Ashley on oboe. The largest stage I'd performed on yet, and a real
        lesson in playing in harmony with other instruments and staying on the beat.
      </p>
    </Moment>

    <Moment
      num="04 — Winter Chamber Music Concert"
      title="Six pieces by Isabella Leonarda"
      images={[
        { src: 'images/flute-winter-chamber/flute-winter-chamber-01.jpg', alt: 'Ari Lee with her parents and flowers after the Winter Chamber Music Concert at Exeter' },
        { src: 'images/flute-winter-chamber/flute-winter-chamber-02.jpg', alt: 'Flute, clarinet, and harpsichord trio rehearsing in a glass-walled recital hall' },
      ]}
    >
      <p>
        My parents flew from Korea to see me perform at Exeter for the first time. I've fallen
        in love with flute here — there are so many opportunities to perform and connect with
        other musicians.
      </p>
    </Moment>

    <Moment
      num="05 — Riverwoods Nursing Home Concert"
      title="A flute solo, for an audience that noticed"
      images={[
        { src: 'images/nursing-home-concert/nursing-home-concert-01.jpg', alt: 'Ari Lee performing flute for residents at Riverwoods Nursing Home, sheet music for Allegretto by Benjamin Godard in the foreground' },
        { src: 'images/nursing-home-concert/nursing-home-concert-03.jpg', alt: 'A harpist performing for residents seated in the Riverwoods common room' },
        { src: 'images/nursing-home-concert/nursing-home-concert-02.jpg', alt: 'A handwritten thank-you note and gift card from Riverwoods addressed to Ari Lee and the other musicians' },
      ]}
    >
      <p>
        A group of musicians from Exeter — harp, cello, piano, saxophone, and flute — played for
        the Riverwoods community. I performed <em>Allegretto</em> by Benjamin Godard as a solo.
        Playing for this audience was different from playing for a hall — and they wrote back.
      </p>
    </Moment>
  </section>

  <div class="arc-divider"><ArcMotif size={48} /></div>

  <section class="section section--tight">
    <span class="eyebrow">Ensembles &amp; Results</span>
    <ul class="awards-list" style="margin-top:0.8rem;">
      <li>
        <div><span class="award-title">Phillips Exeter Symphony Orchestra</span><span class="award-detail">Second Flute — 50+ member orchestra, full-scale concerts each semester</span></div>
        <span class="award-year">2025–Present</span>
      </li>
      <li>
        <div><span class="award-title">Concert Band</span><span class="award-detail">Flute — 30-member band, incl. the MLK Jr. Tribute Concert</span></div>
        <span class="award-year">2024–2025</span>
      </li>
      <li>
        <div><span class="award-title">Chamber Music Group</span><span class="award-detail">Flute — rotating trios with piano, oboe, and harpsichord</span></div>
        <span class="award-year">2023–2025</span>
      </li>
      <li>
        <div><span class="award-title">ABRSM Flute</span><span class="award-detail">Grade 6, Merit — 125/150</span></div>
        <span class="award-year">2023</span>
      </li>
      <li>
        <div><span class="award-title">ABRSM Flute</span><span class="award-detail">Grade 5, Distinction — 130/150</span></div>
        <span class="award-year">2022</span>
      </li>
      <li>
        <div><span class="award-title">ABRSM Music Theory</span><span class="award-detail">Grade 5, Distinction</span></div>
        <span class="award-year">2022</span>
      </li>
      <li>
        <div><span class="award-title">Radio Host — More Than K-Pop</span><span class="award-detail">Introducing American audiences to Korean music beyond mainstream K-pop</span></div>
        <span class="award-year">2024–Present</span>
      </li>
    </ul>
  </section>
</Layout>
