---
import Layout from '../layouts/Layout.astro';
import ArcMotif from '../components/ArcMotif.astro';
import { withBase } from '../lib/url.js';
---
<Layout title="Service & Awards" description="Hair donation, weightlifting leadership, and the full record of competitions and honors." slug="service-awards" sheetNum="A7.00">
  <section class="section section--tight">
    <span class="eyebrow">A7.00 — Service &amp; Awards</span>
    <h1 style="font-size:clamp(2rem,4vw,2.8rem); margin-top:0.5rem;">The Record</h1>
    <p class="lede">
      The quieter, ongoing commitments, and the full index of everything else on this site adds
      up to.
    </p>
  </section>

  <section class="section">
    <div class="moment">
      <div class="moment__media">
        <div class="grid-2">
          <div class="frame">
            <img src={withBase('images/hair-donation/hair-donation-01.jpg')} alt="Ari Lee holding freshly cut hair, moments after donating it" loading="lazy" />
          </div>
          <div class="frame">
            <img src={withBase('images/hair-donation/hair-donation-02.jpg')} alt="Several braided hair donations bundled and ready to send to Wigs for Kids" loading="lazy" />
          </div>
        </div>
      </div>
      <div class="moment__body">
        <span class="moment__num">Community Service — Three Years Running</span>
        <h3 class="moment__title">Hair Donation, Wigs for Kids</h3>
        <p>
          Grown and donated hair to Wigs for Kids for three consecutive years — one of the few
          organizations that accepts hair for children who cannot use chemically treated wigs, for
          medical reasons.
        </p>
      </div>
    </div>
  </section>

  <div class="arc-divider"><ArcMotif size={48} /></div>

  <section class="section section--tight">
    <span class="eyebrow">Also at Exeter</span>
    <ul class="awards-list" style="margin-top:0.8rem;">
      <li>
        <div><span class="award-title">Girls Weightlifting — Co-head</span><span class="award-detail">Co-manages training sessions and instructs proper lifting technique</span></div>
        <span class="award-year">2024–Present</span>
      </li>
    </ul>
  </section>

  <section class="section section--tight">
    <span class="eyebrow">Full Index</span>
    <ul class="awards-list" style="margin-top:0.8rem;">
      <li>
        <div><span class="award-title">AIA New Hampshire Architecture Competition</span><span class="award-detail">1st Place &amp; $650 — Arc Resonance Center · Sheet A2.00</span></div>
        <span class="award-year">2026</span>
      </li>
      <li>
        <div><span class="award-title">Scholastic Art &amp; Writing Awards — Architecture &amp; Industrial Design</span><span class="award-detail">Silver Key — Ithaca State Park Playground · Sheet A2.00</span></div>
        <span class="award-year">2026</span>
      </li>
      <li>
        <div><span class="award-title">Scholastic Art &amp; Writing Awards — Photography</span><span class="award-detail">Bronze Key — Differentiable · Sheet A4.00</span></div>
        <span class="award-year">2026</span>
      </li>
      <li>
        <div><span class="award-title">Architecture Foundation of San Francisco</span><span class="award-detail">3rd Place · Sheet A2.00</span></div>
        <span class="award-year">2026</span>
      </li>
      <li>
        <div><span class="award-title">Young Architecture and Design Contest</span><span class="award-detail">National competition, submitted · Sheet A2.00</span></div>
        <span class="award-year">2026</span>
      </li>
      <li>
        <div><span class="award-title">Certificate of Recognition</span><span class="award-detail">International Youth Research Paper Competition · Sheet A3.00</span></div>
        <span class="award-year">2026</span>
      </li>
      <li>
        <div><span class="award-title">American Mathematics Competition (AMC 12)</span><span class="award-detail">12A: 96 · 12B: 93</span></div>
        <span class="award-year">2025, 2026</span>
      </li>
      <li>
        <div><span class="award-title">American Invitational Mathematics Examination (AIME I)</span><span class="award-detail">Score: 5</span></div>
        <span class="award-year">2026</span>
      </li>
      <li>
        <div><span class="award-title">38th Annual Stanford Invitational — Public Forum Debate</span><span class="award-detail">Double Octafinalist · Sheet A6.00</span></div>
        <span class="award-year">2024</span>
      </li>
      <li>
        <div><span class="award-title">ABRSM Flute</span><span class="award-detail">Distinction, 130/150 · Sheet A5.00</span></div>
        <span class="award-year">2022</span>
      </li>
      <li>
        <div><span class="award-title">ABRSM Flute</span><span class="award-detail">Merit, 125/150 · Sheet A5.00</span></div>
        <span class="award-year">2023</span>
      </li>
      <li>
        <div><span class="award-title">Ski Instructor</span><span class="award-detail">Korean Ski Association</span></div>
        <span class="award-year">2020</span>
      </li>
    </ul>
  </section>
</Layout>
