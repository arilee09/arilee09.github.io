---
import { withBase } from '../lib/url.js';
import Gallery from './Gallery.astro';

interface ImgSpec { src: string; alt: string; }
interface Props {
  num: string;
  title: string;
  meta?: string;
  images?: ImgSpec[];
  placeholderNote?: string;
}
const { num, title, meta, images = [], placeholderNote } = Astro.props;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<article class="moment">
  <div class="moment__media">
    {images.length > 1 ? (
      <Gallery id={slug} images={images} />
    ) : images.length === 1 ? (
      <div class="feature-frame feature-frame--sm">
        <img src={withBase(images[0].src)} alt={images[0].alt} loading="lazy" />
      </div>
    ) : (
      <div class="feature-frame feature-frame--sm placeholder">{placeholderNote || 'Photos coming soon'}</div>
    )}
  </div>
  <div class="moment__body">
    <span class="moment__num">{num}{meta ? ` — ${meta}` : ''}</span>
    <h3 class="moment__title">{title}</h3>
    <slot />
  </div>
</article>
